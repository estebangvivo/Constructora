# URL pública del sitio (Railway / dominio custom). Evita redirects a 0.0.0.0.
NEXT_PUBLIC_APP_URL=https://www.bunas.com.ar

# Base de datos local (docker compose up -d)
DATABASE_URL="postgresql://constructora:constructora@localhost:5432/constructora?schema=public"

# Clerk — https://dashboard.clerk.com (opcional).
# Si queda vacío, se usa login local (email/contraseña).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# true = entra sin login con usuario seed (solo desarrollo). Preferí false + login local.
AUTH_DEV_BYPASS=false

# Org del monitor público /turnero/pantalla (sin login). Default: demo-constructora
# TURNERO_PUBLIC_ORG_SLUG=demo-constructora

# Secreto para firmar la cookie de sesión local (login email/contraseña).
AUTH_SECRET=cambia-este-secreto-en-produccion

# --- Búsqueda CUIT/DNI sin certificado ARCA (recomendado) ---
# https://indicadores.ar/api-empresas → API key gratis
INDICADORES_API_KEY=

# Afip SDK (opcional). prod requiere ARCA_CERT + ARCA_KEY
AFIPSDK_ACCESS_TOKEN=
ARCA_ENV=dev
ARCA_CUIT_REPRESENTADA=20409378472
# ARCA_CERT=
# ARCA_KEY=

# Cron (Authorization: Bearer … o ?secret=)
# - GET /api/cron/fx  → cotización BNA
# - GET /api/cron/alerts → alertas de cheques (email/WhatsApp)
CRON_SECRET=

# --- Billing SaaS (Mercado Pago + transferencia) ---
# MERCADOPAGO_ACCESS_TOKEN=TEST-... o APP_USR-...
# También se puede cargar desde Administración → Mercado Pago (superadmin).
MERCADOPAGO_ACCESS_TOKEN=
# Fallback TC USD→ARS si no hay cotización en DB
BILLING_USD_ARS_FALLBACK=1000
BILLING_TRANSFER_ACCOUNT_NAME=Buñas S.A.S.
BILLING_TRANSFER_TAX_ID=30-00000000-0
BILLING_TRANSFER_BANK_ARS=Banco Galicia
BILLING_TRANSFER_CBU_ARS=0070000000000000000000
BILLING_TRANSFER_ALIAS_ARS=BUNAS.PAGOS
BILLING_TRANSFER_BANK_USD=Cuenta USD
BILLING_TRANSFER_ACCOUNT_USD=
BILLING_TRANSFER_NOTES=Indicá tu email de registro en el concepto.

# Emails superadmin (CSV). Default: adminesteban@bunas.com.ar
# — ve TODAS las empresas y solicitudes de mejora en Administración.
# PLATFORM_SUPERADMIN_EMAILS=otro@email.com
PLATFORM_SUPERADMIN_EMAILS=
# Contraseña del usuario AdminEsteban en deploy (seed-platform-superadmin).
# PLATFORM_SUPERADMIN_PASSWORD=SebaEmma0210

# --- WhatsApp Business Cloud API (PDF + avisos de pago) ---
# https://developers.facebook.com/docs/whatsapp/cloud-api
# Sin esto, en celular se usa el menú nativo; en PC no se puede adjuntar solo.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0

# --- Email (avisos de pago aceptado / rechazado vía Resend) ---
# https://resend.com — dominio verificado en Resend
RESEND_API_KEY=
EMAIL_FROM=Buñas <noreply@tudominio.com>
