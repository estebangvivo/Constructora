{
  "name": "constructora",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.16.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:https": "next dev -H 0.0.0.0 --experimental-https",
    "tunnel": "node scripts/dev-tunnel.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:prod": "prisma db push && tsx prisma/seed-empresa-test.ts && next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:empresa-test": "tsx prisma/seed-empresa-test.ts",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "db:clean": "tsx scripts/clean-operational-data.ts",
    "db:studio": "prisma studio",
    "fx:sync-bna": "tsx scripts/sync-bna-rate.ts",
    "manual:screenshots": "node scripts/capture-manual-screenshots.mjs",
    "manual:pdf": "node scripts/export-manual-pdf.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.25.4",
    "@prisma/client": "^6.12.0",
    "@types/pdf-parse": "^1.1.5",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.4",
    "lucide-react": "^0.525.0",
    "next": "^15.4.2",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@csstools/postcss-cascade-layers": "^6.0.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.16.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "browserslist": "^4.28.7",
    "playwright": "^1.61.1",
    "prisma": "^6.12.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
